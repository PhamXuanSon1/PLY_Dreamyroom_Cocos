{
  "package_version": 2,
  "name": "playable-size-inspector",
  "version": "0.4.0",
  "description": "Phân tích dung lượng build playable (web-mobile, HTML cuối) và tối ưu nguồn: ảnh, âm thanh, model 3D, module engine (Feature Cropping)",
  "main": "./main.js",
  "editor": ">=3.6.0",
  "author": "Nam Phuong",
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "panels": {
    "default": {
      "title": "Playable Size Inspector",
