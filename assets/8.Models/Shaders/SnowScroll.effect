// SnowScroll — sprite 2D cuộn UV theo thời gian (tuyết rơi / mây trôi...), node KHÔNG di chuyển.
// Texture phải để Wrap Mode = Repeat. scrollSpeed: số vòng texture trôi mỗi giây (y âm = trôi xuống).
CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        scrollSpeed: { value: [0.0, -0.06, 0.0, 0.0], editor: { type: vec4, tooltip: 'x, y = tốc độ cuộn UV mỗi giây (y âm = tuyết rơi xuống). z, w không dùng.' } }
        swayAmount: { value: 0.01, editor: { slide: true, range: [0, 0.1], step: 0.001, tooltip: 'Biên độ lắc ngang (đơn vị UV).' } }
        swaySpeed: { value: 0.8, editor: { slide: true, range: [0, 5], step: 0.01, tooltip: 'Tốc độ lắc ngang.' } }
        alphaThreshold: { value: 0.5 }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;

  uniform SnowScrollParams {
    vec4 scrollSpeed;
    float swayAmount;
    float swaySpeed;
  };

  #if USE_TEXTURE
    in vec2 uv0;
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif

  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      float t = cc_time.x;
      vec2 uv = uv0 + scrollSpeed.xy * t;
      uv.x += sin(t * swaySpeed + uv0.y * 6.2831) * swayAmount;
      // fract: luôn lấy mẫu trong [0,1] — vẫn lặp đúng kể cả khi texture không để Repeat
      o *= CCSampleWithAlphaSeparated(cc_spriteTexture, fract(uv));
    #endif

    o *= color;
    ALPHA_TEST(o);
    return o;
  }
}%
